@{
    Layout = "_Layout";
    ViewData["Title"] = "Registro de usuario";
}

@using SC_701_PAW_Lunes.ViewModel
@model RegisterViewModel

<div class="container m-2">

    Ya te encuentras registrado(a)?
    <a class="" href="/Account/Login">
        Inicia sesión
    </a>

</div>

<h2>Registro de nuevos usuarios</h2>

@if (@ViewData["userError"] != null ) {
<span class="text-danger"> @ViewData["userError"] </span>
}

<form action="/Account/Register" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group mb-2">
        <label asp-for="Email" class="mb-2">Correo electrónico</label>
        <input asp-for="Email" class="form-control" name="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="FullName" class="mb-2">Nombre completo</label>
        <input asp-for="FullName" class="form-control" name="FullName" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Direccion" class="mb-2">Direccion</label>
        <input asp-for="Direccion" class="form-control" name="Direccion" />
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="SelectedRole"  class="mb-2">Tipo de cuenta</label>
        <select class="form-control" name="SelectedRole">
            <option value="USER" selected>Usuario</option>
            <option value="ADMIN">Administrador (otro administrador debe activar tu cuenta)</option>
        </select>
        <span asp-validation-for="SelectedRole" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Password" class="mb-2">Contraseña</label>
        <input asp-for="Password" class="form-control" name="Password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="ConfirmPassword" class="mb-2">Repetir Contraseña</label>
        <input asp-for="ConfirmPassword" class="form-control" name="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrarse</button>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}