@using SC_701_PAW_Lunes.ViewModel
@model ReporteViewModel
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inventory App - @ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom CSS (optional) -->
    <link href="~/css/site.css" rel="stylesheet" />
</head>

@{
    ViewData["Title"] = "Reportes de Inventario";
}

<h2 class="text-center mb-4 text-primary">
    <i class="fas fa-chart-line"></i> Reportes de Inventario
</h2>

<div class="container mt-4">
    <div class="card shadow p-3 mb-4 bg-white rounded">
        <h3 class="text-center text-success">
            <i class="fas fa-box-open"></i> Ventas por Producto
        </h3>
        <table class="table table-hover">
            <thead class="table-success">
                <tr>
                    <th>Producto</th>
                    <th>Cantidad Vendida</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.VentasPorProducto)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.CantidadVendida</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card shadow p-3 mb-4 bg-white rounded">
        <h3 class="text-center text-warning">
            <i class="fas fa-sync-alt"></i> Rotación de Inventario
        </h3>
        <table class="table table-hover">
            <thead class="table-warning">
                <tr>
                    <th>Producto</th>
                    <th>Rotación Inventario</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RotacionInventario)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.RotacionInventario</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card shadow p-3 mb-4 bg-white rounded">
        <h3 class="text-center text-danger">
            <i class="fas fa-tags"></i> Ventas por Categoría
        </h3>
        <table class="table table-hover">
            <thead class="table-danger">
                <tr>
                    <th>Categoría</th>
                    <th>Total Ventas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.VentasPorCategoria)
                {
                    <tr>
                        <td>@item.Categoria</td>
                        <td>@item.TotalVentas.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="text-center">
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg mt-3">
        <i class="fas fa-home"></i> Volver al Inicio
    </a>
</div>

<!-- FontAwesome para iconos -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>